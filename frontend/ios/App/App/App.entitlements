<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- myGym: the App Group the widgets read their numbers from (lib/widgets.js -> WidgetBridgePlugin -> widget.json). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.madhavsais.mygym</string>
	</array>
</dict>
</plist>
