<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- myGym: a free Apple ID cannot sign App Groups, so the app and its widgets share the widget snapshot
	     through this keychain group (SharedSnapshot in App/WorkoutActivity.swift). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.madhavsais.mygym.shared</string>
	</array>
</dict>
</plist>
