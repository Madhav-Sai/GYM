    "@fastify/rate-limit": "^10.0.0",
    "@gym/db": "workspace:*",
    "@gym/types": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.2.0",
    "jose": "^6.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": { "@types/node": "^22.0.0", "tsx": "^4.19.0", "typescript": "^5.7.0" }
}
