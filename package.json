{
  "name": "gym-platform",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @gym/db generate",
    "db:migrate": "pnpm --filter @gym/db migrate",
    "seed": "pnpm --filter @gym/db seed",
    "seed:admin": "pnpm --filter @gym/db seed:admin"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
